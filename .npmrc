# A compromised transitive dependency's postinstall/preinstall script runs
# arbitrary code on this machine during `npm install`, before anyone has a
# chance to review it — that's a separate supply-chain risk from a malicious
# package's normal runtime code (see ARCHITECTURE.md's network-hardening section).
# Only fsevents (an optional macOS-only native file-watcher binding used by
# Vite/Playwright in dev) currently has an install script in this tree, and
# losing it just means dev-mode file watching falls back to a slower
# cross-platform watcher — no functional break for build/lint/test/deploy.
ignore-scripts=true
