{
  "name": "btc-wallet",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck:worker": "mkdir -p .wrangler && wrangler types .wrangler/worker-runtime.d.ts --no-include-env && tsc -p worker/tsconfig.json && wrangler types -c status/wrangler.toml .wrangler/status-runtime.d.ts --no-include-env && tsc -p status/tsconfig.json",
    "build": "npm run typecheck:worker && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "fuzz:ui": "node scripts/fuzz-send-form.mjs",
    "e2e": "sh e2e/run.sh",
    "status:keygen": "node scripts/status-keygen.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@secondts/bark": "0.25.0",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.9.0",
    "oxlint": "1.80.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "4.1.11",
    "wrangler": "4.151.3"
  }
}
